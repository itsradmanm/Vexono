        android:pathData="M40,52 L54,68 L68,52">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="52"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:color="#7C4DFF" android:offset="0.0" />
                <item android:color="#00E5C7" android:offset="1.0" />
