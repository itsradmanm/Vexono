<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2: Samsung One UI Upcoming Events / Agenda List (matching Image 3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_events_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Date (Today, Tue, May 21 / امروز، جمعه ۱۸ شهریور) + (+) Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/events_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="امروز، جمعه ۱۸ شهریور"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/events_btn_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_button_circle"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/events_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="رویداد یا وظیفه‌ای برای نمایش وجود ندارد"
        android:textColor="#8E8E98"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- List of Up to 3 Events -->
    <LinearLayout
        android:id="@+id/events_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Event Row 1 -->
        <LinearLayout
            android:id="@+id/ev_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_bar_indicator_green" />

            <TextView
                android:id="@+id/ev_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="تولد علی"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ev_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:includeFontPadding="false"
                android:text="تمام روز"
                android:textColor="#8E8E98"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ev_icon_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="🎂"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Divider 1 -->
        <View
            android:id="@+id/ev_div_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#12FFFFFF"
            android:visibility="gone" />

        <!-- Event Row 2 -->
        <LinearLayout
            android:id="@+id/ev_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_bar_indicator_blue" />

            <TextView
                android:id="@+id/ev_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="ورزش و تمرین"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ev_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:includeFontPadding="false"
                android:text="۱۳:۰۰"
                android:textColor="#8E8E98"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ev_icon_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="🏋️"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Divider 2 -->
        <View
            android:id="@+id/ev_div_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#12FFFFFF"
            android:visibility="gone" />

        <!-- Event Row 3 -->
        <LinearLayout
            android:id="@+id/ev_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_bar_indicator_orange" />

            <TextView
                android:id="@+id/ev_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="جلسه کاری"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ev_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:includeFontPadding="false"
                android:text="۱۷:۰۰"
                android:textColor="#8E8E98"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ev_icon_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="📝"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
