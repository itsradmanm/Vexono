<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2: Samsung One UI Today Square (matching Image 2) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top: Month and Year -->
    <TextView
        android:id="@+id/square_month_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="شهریور ۱۴۰۵"
        android:textColor="#DCDCE2"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center/Bottom: Large Day Number + Weekday -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/square_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="۱۸"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/square_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:includeFontPadding="false"
            android:text="جمعه"
            android:textColor="#5E9CFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Occasion Banner (if any) -->
    <TextView
        android:id="@+id/square_occasion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_tag_background"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
