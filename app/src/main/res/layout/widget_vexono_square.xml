<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2: Square Card - full date with occasion and quick stats -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top: Weekday and Year -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/square_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="چهارشنبه"
            android:textColor="#00E5C7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/square_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="۱۴۰۳"
            android:textColor="#9E9EA8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Center: Large Day Number -->
    <TextView
        android:id="@+id/square_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:text="۱۵"
        android:textColor="#F5F5F7"
        android:textSize="44sp"
        android:textStyle="bold" />

    <!-- Month Name -->
    <TextView
        android:id="@+id/square_month_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اسفند"
        android:textColor="#7C4DFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Gregorian Date -->
    <TextView
        android:id="@+id/square_gregorian_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="5 March 2025"
        android:textColor="#6E6E7A"
        android:textSize="10sp" />

    <!-- Divider -->
    <View
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <!-- Occasion Banner -->
    <TextView
        android:id="@+id/square_occasion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tag_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textColor="#F5F5F7"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Event and Task Count Row -->
    <LinearLayout
        android:id="@+id/square_stats_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/square_event_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 ۰ رویداد"
            android:textColor="#7C4DFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/square_task_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="✅ ۰ تسک"
            android:textColor="#00E5C7"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
