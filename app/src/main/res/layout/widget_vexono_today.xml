    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/m_cell_0_0" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:gravity="center" android:includeFontPadding="false" android:textSize="10sp" android:textColor="#E0E0E6" />
